+                    .all(|(selector, actual)| *actual == ContractProjection::Place(*selector)) {
+                    variable = true;
+                }
+            }
+            if !variable {
+                b.lookup(out.len(), WORK)?;
+                out.insert(path);
+            }
+        }
+        Ok(out)
+    }
