+            }
+            CorePatternKind::Reference { pattern, .. } => {
+                let mut child = path.to_vec();
+                child.push(0);
+                self.bind_pattern(statement, &child, pattern, value, state, b)
+            }
+            _ => Ok(()),
+        }
+    }
