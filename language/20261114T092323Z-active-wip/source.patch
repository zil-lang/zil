+/// Instantiate one independently declared universal lifetime frame for this
+/// invocation. Its roles are fresh solver variables, disjoint from the called
+/// signature's own Invocation roles; all nested Bound frames are preserved.
+pub(crate) fn universal_callable(
+    value: &SemanticSignatureRecipe,
+    lifetimes: u32,
+    limits: &Limits,
+    left: &mut usize,
+) -> R<SemanticSignatureRecipe> {
+    crate::dyn_metadata::semantic_operand_snapshot(value, limits, left, 1)?;
+    value.invocation_lifetimes.checked_add(lifetimes).ok_or_else(|| {
+        bad("original universal callable role count overflows")
+    })?;
+    let empty = BTreeMap::new();
+    let substitution = Substitution {
+        frames: &[], selves: &[], environments: &[],
+        implicit: &empty, invocation: &empty, shift: 0,
+    };
+    let mut result = value.clone();
+    Apply {
+        type_equations: &[], local_equations: &[], delayed: None,
+        substitution: &substitution, limits, left,
+        bound_depth: 0, bound_delta: 0, bound_cutoff: 0,
+        invocation_depth: 0, fresh_roles: false,
+        template: false, template_implicit: false,
+        scopes: None, allow_root_invocation: true,
+        forall: Some((lifetimes, value.invocation_lifetimes)),
+    }.signature(&mut result, 1)?;
+    Ok(result)
+}
