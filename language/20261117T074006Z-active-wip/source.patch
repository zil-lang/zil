+/// A Direct FnOnce capability describes the whole consuming operation, not
+/// only its user entry. A surrounding Task continuation cannot supply this
+/// synchronous upper. Real constructors and environment writes must all agree.
+pub(crate) fn require_direct_consuming_environment(module:&TypedModule,id:ClosureId,b:&mut Budget)->Check<()>{
+    let definition=crate::closures::definition(module,id,None)?;
+    if once_cleanup_has_no_task(module,id,b)?||once_cleanup_closed(module,id,b)?{return Ok(());}
+    let check_capture=|function:&TypedFunction,value:ValueId,ty:&Type,b:&mut Budget,span|->Check<()>{
+        if contains_kind(module,ty,b,true)?{return Err(reject("E-VERIFY-TASK",span,"Direct consuming capability has no synchronous remaining asynchronous-registration retirement proof"));}
+        if contains_kind(module,ty,b,false)?{
+            if !b.task_origin_roots{return Err(reject("E-VERIFY-TASK",span,"Direct consuming capability lacks complete Task source scheduling"));}
+            require_value(module,function,value,b,span)?;
+        }
+        Ok(())
+    };
+    let mut found=false;
+    for function in &module.functions{
+        b.spend(function.blocks.len())?;
+        for block in &function.blocks{for instruction in &block.instructions{
+            b.spend(1)?;
+            match &instruction.kind{
+                InstructionKind::MakeClosure{closure,captures}if *closure==id=>{
+                    if captures.len()!=definition.captures.len(){return Err(reject("E-VERIFY-TASK",Some(instruction.span),"Direct consuming capability changes its complete actual capture arity"));}
+                    found=true;
+                    for(value,ty)in captures.iter().zip(&definition.captures){
+                        resources::charge_payload(ty,b)?;
+                        if function.values.get(value.0 as usize)!=Some(ty){return Err(reject("E-VERIFY-TASK",Some(instruction.span),"Direct consuming capability changes its actual capture type"));}
+                        check_capture(function,*value,ty,b,Some(instruction.span))?;
+                    }
+                },
+                InstructionKind::WriteCapture{index,value}if function.environment==Some(id)=>{
+                    let ty=definition.captures.get(*index as usize).ok_or_else(||reject("E-VERIFY-TASK",Some(instruction.span),"Direct consuming capability writes an absent capture"))?;
+                    resources::charge_payload(ty,b)?;
+                    if function.values.get(value.0 as usize)!=Some(ty){return Err(reject("E-VERIFY-TASK",Some(instruction.span),"Direct consuming capability retags a replacement capture"));}
+                    check_capture(function,*value,ty,b,Some(instruction.span))?;
+                },
+                _=>{},
+            }
+        }}
+    }
+    if !found{return Err(reject("E-VERIFY-TASK",None,"Direct consuming capability has no complete actual constructor source inventory"));}
+    Ok(())
+}
