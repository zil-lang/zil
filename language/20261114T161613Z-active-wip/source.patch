+        _ => value_type(
+            f,
+            i.result
+                .ok_or_else(|| failure("Mutex operation omits its complete actual family"))?,
+        )?,
+    };
+    family_payload(ty).ok_or_else(|| failure("Mutex operation selects no complete actual payload"))
