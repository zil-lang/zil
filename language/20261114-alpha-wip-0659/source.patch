+    left: &mut usize,
+) -> R<SemanticRequirementRecipe> {
+    crate::dyn_metadata::semantic_operand_snapshot(value, limits, left, 1)?;
+    let mut value = value.clone();
+    let empty = BTreeMap::new();
+    let substitution = Substitution {
+        frames: &[], selves: &[], environments: &[], implicit: &empty,
+        invocation: &empty, shift: 0,
+    };
+    Apply {
+        substitution: &substitution, type_equations: equations,
+        local_equations: &[], delayed: None, limits, left,
+        bound_depth: 0, bound_delta: 0, bound_cutoff: 0, invocation_depth: 0,
+        fresh_roles: false, template: false, template_implicit: false,
