+        binder_count: life.binder_count,
+        slots: vec![],
+        retained: vec![],
+        nominal_arguments: vec![],
+    };
+    for slot in &life.slots {
+        let mut path = vec![P::Field(1)];
+        path.extend_from_slice(&slot.path);
