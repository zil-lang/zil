+/// Batch tiny formatter fragments before updating SHA; this fixed size is part
+/// of research093's preregistered implementation, not a semantic input.
+struct DebugHash {
+    hash: sha256::State,
+    bytes: [u8; 4096],
+    used: usize,
+}
+impl DebugHash {
+    fn new() -> Self {
+        Self {
+            hash: sha256::State::new(),
+            bytes: [0; 4096],
+            used: 0,
+        }
+    }
+    fn finish(mut self) -> [u8; 32] {
+        self.hash.update(&self.bytes[..self.used]);
+        self.hash.finish()
+    }
+}
+impl fmt::Write for DebugHash {
+    fn write_str(&mut self, value: &str) -> fmt::Result {
+        let mut bytes = value.as_bytes();
+        if self.used != 0 {
+            let n = bytes.len().min(self.bytes.len() - self.used);
+            self.bytes[self.used..self.used + n].copy_from_slice(&bytes[..n]);
+            self.used += n;
+            bytes = &bytes[n..];
+            if self.used == self.bytes.len() {
+                self.hash.update(&self.bytes);
+                self.used = 0;
+            }
+        }
+        if bytes.len() >= self.bytes.len() {
+            let bulk = bytes.len() / self.bytes.len() * self.bytes.len();
+            self.hash.update(&bytes[..bulk]);
+            bytes = &bytes[bulk..];
+        }
+        if !bytes.is_empty() {
+            self.bytes[..bytes.len()].copy_from_slice(bytes);
+            self.used = bytes.len();
+        }
+        Ok(())
+    }
+}
