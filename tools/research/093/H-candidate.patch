+#[cfg(test)]
+mod impl093_digest_tests {
+    use super::*;
+    use zil_base::{FileId, ModuleId};
+
+    #[test]
+    fn every_public_pipeline_snapshot_retains_exact_identity() {
+        let options = CompileOptions {
+            stop_after: Stage::Lower,
+            ..CompileOptions::default()
+        };
+        let mut session = CompilationSession::with_capacity(1024);
+        let source = SourceUnit::new(
+            FileId(0),
+            ModuleId(0),
+            "093-single.zil",
+            "fn value() -> i32 => 42\nfn main() -> i32 => value()\n",
+        );
+        let report = session.compile_source(&source, &options);
+        assert_eq!(
+            report.status,
+            ResultCategory::Success,
+            "{}",
+            report.to_json()
+        );
+        let project = crate::ProjectSources {
+            root: ModuleId(1),
+            modules: vec![
+                SourceUnit::new(
+                    FileId(1),
+                    ModuleId(1),
+                    "093-main.zil",
+                    "import part\nfn main() -> i32 => part.value()\n",
+                ),
+                SourceUnit::new(
+                    FileId(2),
+                    ModuleId(2),
+                    "093-part.zil",
+                    "pub fn value() -> i32 => 42\n",
+                ),
+            ],
+            paths: BTreeMap::from([(vec!["part".into()], ModuleId(2))]),
+        };
+        let report = session.compile_project(&project, &options);
+        assert_eq!(
+            report.status,
+            ResultCategory::Success,
+            "{}",
+            report.to_json()
+        );
+        let mut seen = [false; 8];
+        for raw in session.raw.values() {
+            let index = match raw {
+                RawSnapshot::Parse(_) => 0,
+                RawSnapshot::Expanded(_) => 1,
+                RawSnapshot::Core(_) => 2,
+                RawSnapshot::Typed(_) => 3,
+                RawSnapshot::Candidate(_) => 4,
+                RawSnapshot::Project(_) => 5,
+                RawSnapshot::ProjectCore(_) => 6,
+                RawSnapshot::ProjectTyped(_) => 7,
+            };
+            seen[index] = true;
+            let original = match raw {
+                RawSnapshot::Typed(module) => module.fingerprint(),
+                other => Fingerprint::of(format!("{other:?}").as_bytes()),
+            };
+            assert_eq!(raw.digest(), original, "raw variant {index}");
+        }
+        assert_eq!(seen, [true; 8]);
+    }
+}
