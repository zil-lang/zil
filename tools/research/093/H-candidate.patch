+/// Incremental form of the same compression and padding operation. The original
+/// contiguous-input digest stays a separate control path.
+pub(crate) struct State {
+    words: [u32; 8],
+    pending: [u8; 64],
+    used: usize,
+    bytes: u64,
+}
+impl State {
+    pub(crate) fn new() -> Self {
+        Self {
+            words: [
+                0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab,
+                0x5be0cd19,
+            ],
+            pending: [0; 64],
+            used: 0,
+            bytes: 0,
+        }
+    }
+    pub(crate) fn update(&mut self, mut bytes: &[u8]) {
+        self.bytes = self.bytes.wrapping_add(bytes.len() as u64);
+        if self.used != 0 {
+            let n = bytes.len().min(64 - self.used);
+            self.pending[self.used..self.used + n].copy_from_slice(&bytes[..n]);
+            self.used += n;
+            bytes = &bytes[n..];
+            if self.used != 64 {
+                return;
+            }
+            block(&mut self.words, &self.pending, &K);
+            self.used = 0;
+        }
+        let (chunks, remainder) = bytes.as_chunks::<64>();
+        for chunk in chunks {
+            block(&mut self.words, chunk, &K);
+        }
+        self.pending[..remainder.len()].copy_from_slice(remainder);
+        self.used = remainder.len();
+    }
+    pub(crate) fn finish(mut self) -> [u8; 32] {
+        let mut tail = [0u8; 128];
+        tail[..self.used].copy_from_slice(&self.pending[..self.used]);
+        tail[self.used] = 0x80;
+        let length = if self.used < 56 { 64 } else { 128 };
+        tail[length - 8..length].copy_from_slice(&self.bytes.wrapping_mul(8).to_be_bytes());
+        for chunk in tail[..length].as_chunks::<64>().0 {
+            block(&mut self.words, chunk, &K);
+        }
+        let mut result = [0u8; 32];
+        for (i, word) in self.words.into_iter().enumerate() {
+            result[i * 4..i * 4 + 4].copy_from_slice(&word.to_be_bytes());
+        }
+        result
+    }
+}
