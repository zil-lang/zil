+    #[test]
+    fn arbitrary_stream_boundaries_equal_contiguous_sha() {
+        let mut state = 93u64;
+        for n in (0..=256).chain([4095, 4096, 4097, 16383, 65537, 1_000_000]) {
+            let bytes = (0..n)
+                .map(|_| {
+                    state = state.wrapping_mul(6364136223846793005).wrapping_add(1);
+                    (state >> 32) as u8
+                })
+                .collect::<Vec<_>>();
+            let expected = digest(&bytes);
+            for size in [1, 3, 55, 56, 63, 64, 65, 127, 128, 4096] {
+                let mut hash = State::new();
+                hash.update(&[]);
+                for chunk in bytes.chunks(size) {
+                    hash.update(chunk);
+                    hash.update(&[]);
+                }
+                assert_eq!(hash.finish(), expected, "length={n} chunk={size}");
+            }
+        }
+    }
+}
