+#[test]
+fn grouped_error_propagation_preserves_member_index_call_and_nested_try() {
+    let module = parsed(
+        "fn f() { let a = (x?).field; let b = (x?)?; let c = (x?)[i]; let d = (x?)(arg); let e = call(x?); let f = (x?, y); let g = [x?, y] }",
+    );
+    let ItemKind::Function(function) = &module.items[0].kind else {
+        panic!("function")
+    };
+    let FunctionBody::Block(block) = &function.body else {
+        panic!("block")
+    };
+    let values: Vec<_> = block
+        .statements
+        .iter()
+        .map(|statement| {
+            let StmtKind::Binding { value, .. } = &statement.kind else {
+                panic!("binding")
+            };
+            value
+        })
+        .collect();
+    for value in &values[..4] {
+        let object = match &value.kind {
+            ExprKind::Member { object, .. } | ExprKind::Index { object, .. } => object,
+            ExprKind::Call { callee, .. } => callee,
+            ExprKind::Try(object) => object,
+            other => panic!("unexpected outer operation {other:?}"),
+        };
+        let ExprKind::Group(inner) = &object.kind else {
+            panic!("explicit grouping")
+        };
+        assert!(matches!(inner.kind, ExprKind::Try(_)));
+    }
+    assert!(matches!(values[0].kind, ExprKind::Member { .. }));
+    assert!(matches!(values[1].kind, ExprKind::Try(_)));
+    assert!(matches!(values[2].kind, ExprKind::Index { .. }));
+    assert!(matches!(values[3].kind, ExprKind::Call { .. }));
+    let ExprKind::Call { arguments, .. } = &values[4].kind else {
+        panic!("argument propagation")
+    };
+    assert!(matches!(arguments[0].value.kind, ExprKind::Try(_)));
+    for value in &values[5..] {
+        let (ExprKind::Tuple(elements) | ExprKind::Array(elements)) = &value.kind else {
+            panic!("aggregate element propagation")
+        };
+        assert!(matches!(elements[0].kind, ExprKind::Try(_)));
+    }
+}
