+#[test]
+fn optional_reference_array_callable_and_error_layers_have_fixed_trees() {
+    for (text, expected) in [
+        ("?T", "opt(T)"),
+        ("?&T", "opt(ref(T))"),
+        ("&?T", "ref(opt(T))"),
+        ("?&mut T", "opt(mut(T))"),
+        ("&mut ?T", "mut(opt(T))"),
+        ("&?&T", "ref(opt(ref(T)))"),
+        ("??T", "opt(opt(T))"),
+        ("?&'a mut T", "opt(mut'a(T))"),
+        ("?& &T", "opt(ref(ref(T)))"),
+        ("?[T; 4]", "opt(array(T, 4))"),
+        ("[?T; 4]", "array(opt(T), 4)"),
+        ("?&[T]", "opt(ref(slice(T)))"),
+        ("&[?T]", "ref(slice(opt(T)))"),
+        ("?(A, B)", "opt(tuple(A,B))"),
+        ("(?A, B)", "tuple(opt(A),B)"),
+        ("?()", "opt(tuple())"),
+        ("?Box<T>", "opt(Box<T>)"),
+        ("Box<?T>", "Box<opt(T)>"),
+        ("Box<??T>", "Box<opt(opt(T))>"),
+        ("E!?T", "err(E,opt(T))"),
+        ("?(E!T)", "opt(group(err(E,T)))"),
+        ("?E!T", "err(opt(E),T)"),
+        ("?A | B", "union(opt(A),B)"),
+        ("?(A | B)", "opt(group(union(A,B)))"),
+        ("A | ?B ! ??T", "err(union(A,opt(B)),opt(opt(T)))"),
+        ("?fn() -> T", "opt(fn()->T)"),
+        ("fn() -> ?T", "fn()->opt(T)"),
+        ("&fn() -> T", "ref(fn()->T)"),
+        ("?fn() -> T | U", "opt(fn()->union(T,U))"),
+        ("(?fn() -> T) | U", "union(group(opt(fn()->T)),U)"),
+        ("E!?fn() -> ?T", "err(E,opt(fn()->opt(T)))"),
+        (
+            "?Fn(A, ?B) -> E!?T",
+            "opt(Fn<tuple(A,opt(B)),err(E,opt(T))>)",
+        ),
+        ("&dyn FnMut(?T) -> R", "ref(dyn:FnMut<tuple(opt(T)),R>)"),
+        ("?for<life a> &'a T", "opt(for:a(ref'a(T)))"),
+    ] {
+        let module = parsed(&format!("type Example = {text}"));
+        assert_eq!(shape(aliases(&module)[0]), expected, "{text}");
+    }
+}
