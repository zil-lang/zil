+    let ExprKind::Call { callee, .. } = &value.kind else {
+        panic!("call")
+    };
+    let ExprKind::TypeApply { arguments, .. } = &callee.kind else {
+        panic!("generic call")
+    };
+    assert!(matches!(
+        &arguments[0],
+        GenericArg::Type(TypeRef {
+            kind: TypeKind::Optional(_),
+            ..
+        })
+    ));
+    let result = zil_syntax::parse(&source("fn bad(x: T) { let y = ?x }"));
+    assert!(
