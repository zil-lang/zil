+use zil_base::{FileId, Limits, ModuleId, ResultCategory, SourceUnit};
+use zil_syntax::ast::*;
+
+fn source(text: &str) -> SourceUnit {
+    SourceUnit::new(FileId(18), ModuleId(18), "optional-prefix.zil", text)
+}
+
+fn parsed(text: &str) -> Module {
+    zil_syntax::parse(&source(text)).into_result().unwrap()
+}
+
+fn aliases(module: &Module) -> Vec<&TypeRef> {
+    module
+        .items
+        .iter()
+        .map(|item| {
+            let ItemKind::TypeAlias(alias) = &item.kind else {
+                panic!("alias")
+            };
+            alias.value.as_ref().unwrap()
+        })
+        .collect()
+}
+
+// Independent, deliberately limited AST observer. Expected trees below are
+// written from the language contract, not obtained from the parser/printer.
+fn shape(ty: &TypeRef) -> String {
+    let list = |values: &[TypeRef]| values.iter().map(shape).collect::<Vec<_>>().join(",");
+    let arguments = |args: &[GenericArg]| {
+        args.iter()
+            .map(|arg| match arg {
+                GenericArg::Type(ty) => shape(ty),
+                GenericArg::Const(Expr {
+                    kind: ExprKind::Literal(Literal::Integer(value)),
+                    ..
+                }) => value.clone(),
+                other => panic!("unhandled fixture argument {other:?}"),
+            })
+            .collect::<Vec<_>>()
+            .join(",")
+    };
+    match &ty.kind {
+        TypeKind::Named { path, args } if args.is_empty() => path.join("."),
+        TypeKind::Named { path, args } => format!("{}<{}>", path.join("."), arguments(args)),
+        TypeKind::Dyn { path, args } => format!("dyn:{}<{}>", path.join("."), arguments(args)),
+        TypeKind::Optional(inner) => format!("opt({})", shape(inner)),
+        TypeKind::Reference {
+            lifetime,
+            mutable,
+            inner,
+        } => format!(
+            "{}{}({})",
+            if *mutable { "mut" } else { "ref" },
+            lifetime.as_ref().map_or(String::new(), |x| format!("'{x}")),
+            shape(inner)
+        ),
+        TypeKind::Group(inner) => format!("group({})", shape(inner)),
+        TypeKind::Tuple(elements) => format!("tuple({})", list(elements)),
+        TypeKind::Array { element, length } => match length {
+            Some(value) => {
+                let ExprKind::Literal(Literal::Integer(value)) = &value.kind else {
+                    panic!("fixture array length")
+                };
+                format!("array({}, {value})", shape(element))
+            }
+            None => format!("slice({})", shape(element)),
+        },
+        TypeKind::Function { params, result } => {
+            format!("fn({})->{}", list(params), shape(result))
+        }
+        TypeKind::Error { error, result } => format!("err({},{})", shape(error), shape(result)),
+        TypeKind::Union(members) => format!("union({})", list(members)),
+        TypeKind::ForLifetime { lifetime, inner } => format!("for:{lifetime}({})", shape(inner)),
+        other => panic!("unhandled fixture type {other:?}"),
+    }
+}
