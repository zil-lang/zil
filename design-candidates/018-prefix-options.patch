+#[test]
+fn expression_propagation_remains_postfix_and_binds_before_borrow() {
+    let module = parsed(
+        "fn f(x: E!T) { let a = x?; let b = &x?; let c = &mut x?; let d = make::< ?T >()? }",
+    );
+    let ItemKind::Function(function) = &module.items[0].kind else {
+        panic!("function")
+    };
+    let FunctionBody::Block(block) = &function.body else {
+        panic!("block")
+    };
+    let values: Vec<_> = block
+        .statements
+        .iter()
+        .map(|statement| {
+            let StmtKind::Binding { value, .. } = &statement.kind else {
+                panic!("binding")
+            };
+            value
+        })
+        .collect();
+    assert!(matches!(values[0].kind, ExprKind::Try(_)));
+    for (value, expected) in [
+        (values[1], UnaryOp::Borrow),
+        (values[2], UnaryOp::BorrowMut),
+    ] {
+        let ExprKind::Unary { op, operand } = &value.kind else {
+            panic!("borrow")
+        };
+        assert_eq!(*op, expected);
+        assert!(matches!(operand.kind, ExprKind::Try(_)));
+    }
+    let ExprKind::Try(value) = &values[3].kind else {
+        panic!("propagated generic call")
