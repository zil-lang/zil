+        &Limits {
+            max_call_depth: 32,
+            ..Limits::default()
+        },
+    );
+    assert!(!result.is_ok());
+    assert!(
+        result
+            .diagnostics
+            .iter()
+            .any(|d| d.category == ResultCategory::ResourceLimit)
+    );
+}
