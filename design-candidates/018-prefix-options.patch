+#[test]
+fn prefix_types_keep_spans_newline_boundaries_and_formatting() {
+    let input = source(
+        "  type A = ?\r\n &mut ?T\r\n type B = ?fn(?T) -> E!?T\r\nfn f(x: E!T) {\r\n let y = x?\r\n y\r\n}\r\n",
+    );
+    let before = zil_syntax::parse(&input).into_result().unwrap();
+    let ItemKind::TypeAlias(alias) = &before.items[0].kind else {
+        panic!("alias")
+    };
+    let value = alias.value.as_ref().unwrap();
+    assert_eq!(
+        &input.text[value.span.start..value.span.end],
+        "?\r\n &mut ?T"
+    );
+    assert_eq!(shape(value), "opt(mut(opt(T)))");
+    let output = zil_syntax::format::format(&input).unwrap();
+    let after = parsed(&output);
+    for index in 0..2 {
+        let ItemKind::TypeAlias(before) = &before.items[index].kind else {
+            panic!("alias")
+        };
+        let ItemKind::TypeAlias(after) = &after.items[index].kind else {
+            panic!("alias")
+        };
+        assert_eq!(
+            shape(before.value.as_ref().unwrap()),
+            shape(after.value.as_ref().unwrap())
+        );
+    }
+    let ItemKind::Function(function) = &after.items[2].kind else {
+        panic!("function")
+    };
+    let FunctionBody::Block(block) = &function.body else {
+        panic!("block")
+    };
+    assert_eq!(block.statements.len(), 2);
+    assert!(matches!(block.statements[1].kind, StmtKind::Expression(_)));
+    assert_eq!(
+        zil_syntax::format::format(&source(&output)).unwrap(),
+        output
+    );
+}
