fn inspect<F:Fn()->i32>(f:&F,b:ByteBuffer)->i32{let view=bytes_view(b);let answer=f();return answer+i32(view[0])}fn main()->i32{let a=bytes_new();let b=bytes_new();bytes_reserve(a,1);bytes_push(a,u8(65));bytes_reserve(b,2);bytes_push(b,u8(66));let f=()=>{bytes_push(b,u8(67));return i32(bytes_len(b))};return inspect(&f,b)-67}