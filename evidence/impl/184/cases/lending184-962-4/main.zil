pub fn bytes(value:u8)->impl Fn()->&[u8]{let b=bytes_new();bytes_reserve(b,4);bytes_push(b,value);return move()=>bytes_view(b)}pub fn grow()->impl FnMut(u8)->&[u8]{let b=bytes_new();return move(value)=>{bytes_reserve(b,bytes_len(b)+1);bytes_push(b,value);return bytes_view(b)}}package State<F>{manages storage:ByteBuffer;callback:F;count:i32}fn make<F:Fn()->&[u8]>(callback:F)->State<F>{return State::<F>{storage:bytes_new(),callback:callback,count:0}}fn main()->i32{let current=make(bytes(7u8));let callback=&current.callback;let view=callback();let moved=current;return i32(view.len())}