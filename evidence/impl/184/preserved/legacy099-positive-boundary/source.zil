package P{manages data:ByteBuffer;n:i64} fn make()->P{return P{data:bytes_new(),n:0}} fn fill(b:ByteBuffer)->bool{return bytes_reserve(b,8)&&bytes_push(b,7u8)} fn view(b:ByteBuffer)->&[u8]{return bytes_view(b)} fn size(b:ByteBuffer)->i64{return bytes_len(b)} fn consume(give b:ByteBuffer)->i64{return bytes_len(b)}fn escaped()->impl Fn()->&[u8]{let b=bytes_new();return move()=>bytes_view(b)}fn entry099(){}