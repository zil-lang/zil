fn fan<F:Fn()->i32>(f:&F,n:i32)->i32{if n==1{return f()}if n==2{return f()+f()}if n==3{return f()+f()+f()}if n==4{return f()+f()+f()+f()}if n==5{return f()+f()+f()+f()+f()}if n==6{return f()+f()+f()+f()+f()+f()}if n==7{return f()+f()+f()+f()+f()+f()+f()}if n==8{return f()+f()+f()+f()+f()+f()+f()+f()}return f()+f()+f()+f()+f()+f()+f()+f()+f()} fn main()->i32{let x=1;let f=()=>x;return fan(&f,3)-3}