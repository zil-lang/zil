+                let error = store(&directory, key(), b"replacement").unwrap_err();
+                assert_eq!(error.kind(), io::ErrorKind::AlreadyExists);
+                assert_eq!(fs::read(&pending).unwrap(), b"another owner's file");
+                let after = fs::metadata(&pending).unwrap();
