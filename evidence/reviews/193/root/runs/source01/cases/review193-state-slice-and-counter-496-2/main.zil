extern "C" fn putchar(n:i32)->i32;resource Ticket{n:i32}impl Drop for Ticket{fn drop(self:Self){unsafe{putchar(.n)}}}package State<F>{callback:F;manages bytes:ByteBuffer;count:i32}fn make()->impl FnMut(&mut [u8],&mut i32)->i32{let ticket=Ticket{n:65};var calls=0;return move(s:&mut [u8],p:&mut i32)=>{ticket.n;calls+=1;s[0]+=u8(calls);*p+=i32(s[0]);return *p}}fn run<F:FnMut(&mut [u8],&mut i32)->i32>(state:State<F>)->i32{var current=state;bytes_push(current.bytes,3u8);let callback=&mut current.callback;let window=bytes_view_mut(current.bytes);let count=&mut current.count;let a=callback(window,count);let b=callback(window,count);return a+b+*count}fn main()->i32{return run(State{callback:make(),bytes:bytes_new(),count:0})-24}