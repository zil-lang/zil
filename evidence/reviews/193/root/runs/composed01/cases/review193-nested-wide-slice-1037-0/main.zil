fn first(s:&mut [i64])->&mut i64{return &mut s[0]}fn leaf<F:Fn(&mut [i64])->i64>(f:&F,s:&mut [i64])->i64{return f(s)}fn outer<F:Fn(&mut [i64])->i64>(f:&F,s:&mut [i64])->i64{return leaf(f,s)+leaf(f,s)}fn main()->i32{var values:[i64;2]=[5000000000,2];let f=(s:&mut [i64])=>{let step=s[1];let p=first(s);*p+=step;return *p};let total=outer(&f,&mut values[..]);return i32(total-10000000006)+i32(values[0]-5000000004)}