fn keep<T>(value:T,mode:i32)->T{for index in 0..4{if mode==0{continue}if mode==1{break}if mode==2{continue}if mode==3{break}if mode==4{continue}if mode==5{break}if mode==6{continue}if mode==7{break}if mode==8{continue}if mode==9{break}if mode==10{continue}if mode==11{break}if mode==12{continue}if mode==13{break}if mode==14{continue}if mode==15{break}if mode==16{continue}if mode==17{break}if mode==18{continue}if mode==19{break}if mode==20{continue}if mode==21{break}if mode==22{continue}if mode==23{break}}return value}fn main(){}