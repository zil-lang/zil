extern "C" fn putchar(n:i32)->i32;resource R{n:i32}impl Drop for R{fn drop(self:Self){unsafe{putchar(.n)}}}package P{manages owner:R;count:i64}fn leaf<F:FnMut(&mut i64)->i64>(f:&mut F,p:&mut i64)->i64{return f(p)}fn twice<F:FnMut(&mut i64)->i64>(f:&mut F,p:&mut i64)->i64{return leaf(f,p)+leaf(f,p)}fn main()->i32{var state=P{owner:R{n:66},count:20i64};var captured=P{owner:R{n:65},count:10i64};var f=move(p:&mut i64)=>{let c=&mut captured.count;*c+=*p;*p+=1i64;return *c};let p=&mut state.count;let total=twice(&mut f,p);return i32(total+*p)-103}