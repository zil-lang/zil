resource R{n:i32} package P{manages a:R,manages b:R,n:i32} fn make()->P{return P{a:R{n:20},b:R{n:21},n:1}} fn consume(give r:R)->i32{return r.n} fn keep(give r:R,n:i32)->R contract{result(give)}{return give r} fn step(ok:bool)->bool!i32{if ok{return 0}return true} fn bump(r:R){r.n+=1} fn factory(p:P)->impl Fn()->i32{return move ()=>p.a.n+p.n}fn main()->i32{let f=factory(make());let moved=f;return moved()+moved()-42}