extern "C" fn byte_test_attempts()->i32;extern "C" fn byte_test_releases()->i32;extern "C" fn byte_test_live()->i32;fn counts()->i32{unsafe{return byte_test_attempts()*100+byte_test_releases()*10000+byte_test_live()*1000000}}fn buf(v:u8)->ByteBuffer contract{result(create)}{let b=bytes_new();bytes_reserve(b,8);bytes_push(b,v);return give b}fn get(b:ByteBuffer)->i32{return i32(bytes_view(b)[0])}package P{manages b:ByteBuffer;manages c:ByteBuffer}fn make()->P{return P{b:buf(2u8),c:buf(3u8)}}fn act(a:ByteBuffer,b:ByteBuffer)->i32{let s=bytes_view(a);bytes_push(b,8u8);return i32(s[0])+i32(bytes_len(b))}fn work()->i32{let p=make();return act(p.b,p.c)}fn value()->i32{let answer=work();return answer+counts()}