package P{manages b:ByteBuffer;manages c:ByteBuffer}fn make()->P{return P{b:bytes_new(),c:bytes_new()}}fn act(a:ByteBuffer,b:ByteBuffer)->i64{let s=bytes_view(a);bytes_reserve(b,8);return s.len()}fn relay(a:ByteBuffer,b:ByteBuffer)->i64{return act(a,b)}fn value()->i64{let p=make();return relay(p.b,p.c)}