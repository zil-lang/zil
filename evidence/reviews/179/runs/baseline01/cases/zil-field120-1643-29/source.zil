extern "C" fn byte_test_attempts()->i32;extern "C" fn byte_test_releases()->i32;extern "C" fn byte_test_live()->i32;fn counts()->i32{unsafe{return byte_test_attempts()*100+byte_test_releases()*10000+byte_test_live()*1000000}}fn buf(v:u8)->ByteBuffer contract{result(create)}{let b=bytes_new();bytes_reserve(b,8);bytes_push(b,v);return give b}fn get(b:ByteBuffer)->i32{return i32(bytes_view(b)[0])}package P{manages b:ByteBuffer;manages c:ByteBuffer}fn make()->P{return P{b:buf(2u8),c:buf(3u8)}}enum Fault{Stop}fn fail()->Fault!i32{return Fault.Stop}fn factory()->impl FnOnce()->Fault!i32{let p=make();return move()=>{let s=bytes_view(p.b);let old=give p.c;let n=i32(s[0]);return fail()?+n+get(old)}}fn work(){let f=factory();let answer=f()}fn value()->i32{work();return counts()}