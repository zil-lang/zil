package P{manages b:ByteBuffer;manages c:ByteBuffer}fn make()->P{return P{b:bytes_new(),c:bytes_new()}}fn factory()->impl FnMut()->i64{var p=make();return move()=>{let s=bytes_view(p.b);p.c=bytes_new();bytes_reserve(p.c,4);return s.len()+bytes_len(p.c)}}fn value()->i64{var f=factory();return f()+f()}