extern "C" fn putchar(x:i32)->i32;resource R{n:i32}impl Drop for R{fn drop(self:Self){unsafe{putchar(.n)}}}package P{manages r:R}fn mk(n:i32)->P{return P{r:R{n:n}}}fn relay(a:[P;2])->[P;2]{return a}fn part(flag:bool)->i32{var a=relay([mk(65),mk(66)]);if flag{let x=a[0];if x.r.n!=65{return 1}}else{let y=a[1];if y.r.n!=66{return 2}}return 0}fn main()->i32{return part(true)+part(false)}
