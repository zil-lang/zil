extern "C" fn byte_test_attempts()->i32;extern "C" fn byte_test_releases()->i32;extern "C" fn byte_test_live()->i32;fn counts()->i32{unsafe{return byte_test_attempts()*100+byte_test_releases()*10000+byte_test_live()*1000000}}fn buf(v:u8)->ByteBuffer contract{result(create)}{let b=bytes_new();bytes_reserve(b,8);bytes_push(b,v);return give b}fn get(b:ByteBuffer)->i32{return i32(bytes_view(b)[0])}fn consume(give b:ByteBuffer)->i32{return get(b)}package P{manages left:ByteBuffer;manages right:ByteBuffer;n:i64}fn make()->P{return P{left:buf(2u8),right:buf(3u8),n:i64(9)}}fn relay(p:P)->P{return p}fn factory()->impl FnMut()->i32{let p=make();return move()=>{if bytes_reserve(p.left,13){return -100}return get(p.left)+get(p.right)+i32(bytes_capacity(p.left))}}fn work()->i32{var f=factory();return f()+f()}fn value()->i32{let answer=work();return answer+counts()}