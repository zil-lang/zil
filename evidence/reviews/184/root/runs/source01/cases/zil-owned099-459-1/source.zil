extern "C" fn byte_test_attempts()->i32;extern "C" fn byte_test_releases()->i32;extern "C" fn byte_test_live()->i32;fn counts()->i32{unsafe{return byte_test_attempts()*100+byte_test_releases()*10000+byte_test_live()*1000000}}fn buf(v:u8)->ByteBuffer contract{result(create)}{let b=bytes_new();bytes_reserve(b,8);bytes_push(b,v);return give b}fn get(b:ByteBuffer)->i32{return i32(bytes_view(b)[0])}fn consume(give b:ByteBuffer)->i32{return get(b)}fn factory()->impl FnMut()->i32{let b=buf(2u8);return move()=>{bytes_push(b,9u8);return i32(bytes_len(b))}}fn work()->i32{var f=factory();return f()+f()}fn value()->i32{let answer=work();return answer+counts()}