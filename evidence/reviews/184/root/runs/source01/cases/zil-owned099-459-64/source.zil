extern "C" fn byte_test_attempts()->i32;extern "C" fn byte_test_releases()->i32;extern "C" fn byte_test_live()->i32;fn counts()->i32{unsafe{return byte_test_attempts()*100+byte_test_releases()*10000+byte_test_live()*1000000}}fn buf(v:u8)->ByteBuffer contract{result(create)}{let b=bytes_new();bytes_reserve(b,8);bytes_push(b,v);return give b}fn get(b:ByteBuffer)->i32{return i32(bytes_view(b)[0])}fn consume(give b:ByteBuffer)->i32{return get(b)}package P{manages left:ByteBuffer;manages right:ByteBuffer;n:i64}fn make()->P{return P{left:buf(2u8),right:buf(3u8),n:i64(9)}}fn relay(p:P)->P{return p}enum Fault{Stop}fn work(fail:bool)->Fault!i32{let p=make();if fail{return Fault.Stop}return get(p.left)+get(p.right)}fn value()->i32{let first=work(false);let second=work(true);return counts()}