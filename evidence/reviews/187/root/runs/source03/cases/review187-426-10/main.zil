fn fill(b:ByteBuffer,n:u8)->bool{return bytes_reserve(b,1)&&bytes_push(b,n)}fn inspect<F:Fn()->i32>(pad:i32,f:&F,b:ByteBuffer)->i32{let view=bytes_view(b);let value=f();return pad+value+i32(view[0])}fn run(a:ByteBuffer,b:ByteBuffer)->i32{let f=()=>{bytes_reserve(a,4);return 0};return inspect(9,&f,b)-9}fn main()->i32{let a=bytes_new();let b=bytes_new();if !fill(a,65u8)||!fill(b,66u8){return 8}return run(a,a)-65}