fn fill(b:ByteBuffer,n:u8)->bool{return bytes_reserve(b,1)&&bytes_push(b,n)}package Pair{manages left:ByteBuffer;manages right:ByteBuffer}fn pair()->Pair{return Pair{left:bytes_new(),right:bytes_new()}}fn main()->i32{let p=pair();if !fill(p.left,65u8){return 8}let read=p.left;let again=p.left;let edit=again;let f=()=>{let view=bytes_view(read);bytes_reserve(edit,4);return i32(view[0])};return f()-65}