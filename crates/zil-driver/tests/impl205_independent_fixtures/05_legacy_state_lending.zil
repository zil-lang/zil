fn bytes()->impl FnMut()->&[u8]{let b=bytes_new();return move()=>{bytes_reserve(b,4);bytes_push(b,7u8);return bytes_view(b)}}package State<F>{manages storage:ByteBuffer;callback:F;count:i32}fn pack<F:FnMut()->&[u8]>(callback:F)->State<F>{return State::<F>{storage:bytes_new(),callback:callback,count:0}}fn read<F:FnMut()->&[u8]>(state:State<F>)->i32{var next=state;let first=next.callback();let old=i32(first.len());let second=next.callback();return old+i32(second.len())-3}fn main()->i32{return read(pack(bytes()))}