+// Separate V1 lifetime: a suspended/recursive ordinary invocation has no
+// matching ABI2 owner and cannot accidentally use an outer MC recorder.
+static thread_local const ZilLLVMMachineEmissionHooksV1 *ZilEmissionHooks = nullptr;
+extern "C" LLVM_ABI const ZilLLVMMachineEmissionHooksV1 *
+ZilLLVMSetMachineEmissionHooksV1(const ZilLLVMMachineEmissionHooksV1 *H) {
+  const auto *Old=ZilEmissionHooks; ZilEmissionHooks=H; return Old;
+}
+extern "C" LLVM_ABI const ZilLLVMMachineEmissionHooksV1 *ZilLLVMGetMachineEmissionHooksV1() {
+  const auto *H=ZilLLVMGetFunctionProductHooks();
+  return ZilLLVMProductHookPrefix(H) && ZilEmissionHooks && ZilEmissionHooks->abi==1 &&
+         ZilEmissionHooks->stage_owner==H ? ZilEmissionHooks : nullptr;
+}
+extern "C" LLVM_ABI int ZilLLVMX86MachineEmissionStateV1(const void *P) {
+  if(!P) return 0;
+  const auto *AP=static_cast<const llvm::AsmPrinter *>(P);
+  return AP->getPassID()==&llvm::X86AsmPrinter::ID &&
+         static_cast<const llvm::X86AsmPrinter *>(AP)->zilMachineEmissionStateV1();
+}
+extern "C" LLVM_ABI int ZilLLVMEmitAndCountX86InstructionV1(void *P,void *I) {
+  if(!P || !I || !ZilLLVMX86MachineEmissionStateV1(P)) return 0;
+  static_cast<llvm::X86AsmPrinter *>(P)->zilEmitAndCountV1(*static_cast<llvm::MCInst *>(I));
+  return 1;
+}
+extern "C" LLVM_ABI const void *ZilLLVMPeekMachineBlockSymbolV1(const void *P) {
+  return P ? static_cast<const llvm::MachineBasicBlock *>(P)->zilCachedSymbolForEmissionV1() : nullptr;
+}
+extern "C" LLVM_ABI int ZilLLVMReadOnlyMachineEmissionProviderV1(const void *P) {
+  if(!P)return 0;
+  const auto ID=static_cast<const llvm::Pass *>(P)->getPassID();
+  return ID==&llvm::MachineOptimizationRemarkEmitterPass::ID ||
+         ID==&llvm::LazyMachineBlockFrequencyInfoPass::ID;
+}
