 void MCObjectStreamer::emitInstruction(const MCInst &Inst,
                                        const MCSubtargetInfo &STI) {
+  // LFI can recursively emit instructions. Record only the outer input; the
+  // current original LFI/MC path and X86 shadow tracker still run on replay.
+  static thread_local unsigned EmissionDepth=0;
+  const auto *Emission=ZilLLVMGetMachineEmissionHooksV1();
+  struct DepthGuard {
+    unsigned &Depth; bool Active;
+    ~DepthGuard() { if(Active) --Depth; }
+  } Guard{EmissionDepth,Emission!=nullptr};
+  if(Emission && EmissionDepth++==0 && Emission->observe_mc)
+    Emission->observe_mc(Emission->context,this,&Inst,&STI);
+
   if (LFIRewriter && LFIRewriter->rewriteInst(Inst, *this, STI))
     return;
 
