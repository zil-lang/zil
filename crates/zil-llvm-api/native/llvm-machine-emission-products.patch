 bool AsmPrinter::doFinalization(Module &M) {
+  // Never assemble/finalize a partially replayed function. The adapter's error
+  // marker causes complete Module/TM/MMI/MC destruction and a clean retry.
+  if(const auto *H=ZilLLVMGetFunctionProductHooks(); ZilLLVMProductRequestFailed(H)) {
+    EHHandlers.clear();
+    Handlers.erase(Handlers.begin()+NumUserHandlers,Handlers.end());
+    DD=nullptr; MF=nullptr; MMI=nullptr; AddrLabelSymbols=nullptr;
+    OwnedMLI.reset(); OwnedMDT.reset();
+    return false;
+  }
