+namespace {
+bool zilHeadersHaveNoBodyReferences(const Module &M) {
+  SmallPtrSet<const Value *, 32> SeenValues;
+  SmallPtrSet<const Metadata *, 32> SeenMetadata;
+  SmallVector<const Value *, 32> Values;
+  SmallVector<const Metadata *, 32> Metadata;
+  SmallVector<std::pair<unsigned, MDNode *>, 4> MDs;
+  auto AddMetadata = [&](const GlobalObject &G) {
+    MDs.clear(); G.getAllMetadata(MDs);
+    for (const auto &E : MDs) Metadata.push_back(E.second);
+  };
+  for (const GlobalVariable &G : M.globals()) {
+    if (G.hasInitializer()) Values.push_back(G.getInitializer()); AddMetadata(G);
+  }
+  for (const GlobalAlias &A : M.aliases()) Values.push_back(A.getAliasee());
+  for (const GlobalIFunc &I : M.ifuncs()) {
+    Values.push_back(I.getResolver()); AddMetadata(I);
+  }
+  for (const Function &F : M) {
+    for (const Use &U : F.operands()) Values.push_back(U.get()); AddMetadata(F);
+  }
+  for (const NamedMDNode &N : M.named_metadata())
+    for (const MDNode *MD : N.operands()) Metadata.push_back(MD);
+  while (!Values.empty() || !Metadata.empty()) {
+    while (!Metadata.empty()) {
+      const auto *MD = Metadata.pop_back_val();
+      if (!MD || !SeenMetadata.insert(MD).second) continue;
+      if (const auto *N = dyn_cast<MDNode>(MD)) {
+        for (const MDOperand &O : N->operands()) Metadata.push_back(O.get());
+      } else if (const auto *V = dyn_cast<ConstantAsMetadata>(MD)) {
+        Values.push_back(V->getValue());
+      } else if (!isa<MDString>(MD)) return false;
+    }
+    while (!Values.empty()) {
+      const Value *V = Values.pop_back_val();
+      if (!V || !SeenValues.insert(V).second) continue;
+      if (isa<GlobalValue>(V)) continue;
+      if (!isa<Constant>(V) || isa<BlockAddress>(V)) return false;
+      for (const Use &U : cast<Constant>(V)->operands()) Values.push_back(U.get());
+    }
+  }
+  return true;
+}
