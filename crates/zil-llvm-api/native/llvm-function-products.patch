+extern "C" LLVM_ABI int ZilLLVMModuleProxyProductState(void *Manager, void *IR) {
+  auto &F = *static_cast<llvm::Function *>(IR);
+  auto &M = *F.getParent();
+  auto &AM = *static_cast<llvm::FunctionAnalysisManager *>(Manager);
+  auto *P = AM.getCachedResult<llvm::ModuleAnalysisManagerFunctionProxy>(F);
+  if (!P || !P->getOuterInvalidations().empty()) return -1;
+  const auto &MAM = P->zilProductOuterManager();
+  auto *FP = MAM.getCachedResult<llvm::FunctionAnalysisManagerModuleProxy>(M);
+  if (!FP || &FP->getManager() != &AM) return -1;
+  auto *PSI = MAM.getCachedResult<llvm::ProfileSummaryAnalysis>(M);
+  if ((PSI && !PSI->zilEmptyProductState(&M)) ||
+      M.getProfileSummary(true) || M.getProfileSummary(false)) return -1;
+  struct State { unsigned Code = 1; bool Valid = true; } S;
+  MAM.zilVisitCachedAnalysisIDs(M, [](void *Context, const void *Key) {
+    auto &S = *static_cast<State *>(Context);
+    unsigned Tag = 0;
+    if (Key == llvm::PassInstrumentationAnalysis::ID()) Tag = 1;
+    else if (Key == llvm::FunctionAnalysisManagerModuleProxy::ID()) Tag = 2;
+    else if (Key == llvm::ProfileSummaryAnalysis::ID()) Tag = 3;
+    else S.Valid = false;
+    if (Tag) S.Code = (S.Code << 2) | Tag;
+  }, &S);
+  return S.Valid ? int(S.Code) : -1;
+}
