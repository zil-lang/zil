+  // Fixed resident-product replay. Validation precedes any current mutation.
+  // Analysis caches must be cleared before replacing the owning function body.
+  bool zilRestoreBlockNumberState(unsigned Next, unsigned Epoch,
+                                   ArrayRef<unsigned> Numbers) {
+    if (Numbers.size() != size()) return false;
+    DenseSet<unsigned> Seen;
+    for (unsigned N : Numbers)
+      if (N >= Next || !Seen.insert(N).second) return false;
+    unsigned I = 0;
+    for (BasicBlock &BB : *this) BB.Number = Numbers[I++];
+    NextBlockNum = Next;
+    BlockNumEpoch = Epoch;
+    return true;
+  }
