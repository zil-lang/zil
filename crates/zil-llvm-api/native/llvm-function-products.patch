+// Private, additive native-product rendering entry. Every normal LLVM print
+// path above keeps its original mode. There is no clone, IR mutation, body
+// instruction/type/metadata scan, or retained LLVM owner in this projection.
+void TypeFinder::zilRunHeaders(const Module &M) {
+  OnlyNamed = false;
+  SmallVector<std::pair<unsigned, MDNode *>, 4> MDs;
+  auto Metadata = [&](const GlobalObject &G) {
+    MDs.clear(); G.getAllMetadata(MDs);
+    for (const auto &E : MDs) incorporateMDNode(E.second);
+  };
+  for (const GlobalVariable &G : M.globals()) {
+    incorporateType(G.getValueType());
+    if (G.hasInitializer()) incorporateValue(G.getInitializer());
+    Metadata(G);
+  }
+  for (const GlobalAlias &A : M.aliases()) {
+    incorporateType(A.getValueType());
+    if (const Value *V = A.getAliasee()) incorporateValue(V);
+  }
+  for (const GlobalIFunc &I : M.ifuncs()) {
+    incorporateType(I.getValueType()); incorporateValue(I.getResolver());
+    Metadata(I);
+  }
+  for (const Function &F : M) {
+    incorporateType(F.getFunctionType()); incorporateAttributes(F.getAttributes());
+    for (const Use &U : F.operands()) incorporateValue(U.get());
+    for (const Argument &A : F.args()) incorporateValue(&A);
+    Metadata(F);
+  }
+  for (const NamedMDNode &N : M.named_metadata())
+    for (const MDNode *MD : N.operands()) incorporateMDNode(MD);
+}
