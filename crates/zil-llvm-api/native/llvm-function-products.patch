+static bool zilCurrentLocalNameMap(const llvm::Function &F,
+                                  const llvm::ValueSymbolTable *Table) {
+  uint64_t Named = 0;
+  auto Valid = [&](const llvm::Value &V) {
+    if (!V.hasName()) return true;
+    ++Named;
+    return Table && Table->lookup(V.getName()) == &V;
+  };
+  for (const auto &A : F.args()) if (!Valid(A)) return false;
+  for (const auto &BB : F) {
+    if (!Valid(BB)) return false;
+    for (const auto &I : BB) if (!Valid(I)) return false;
+  }
+  return Table ? Named == Table->size() : Named == 0;
+}
+extern "C" LLVM_ABI int ZilLLVMFunctionSymbolState(
+    const void *IR, uint32_t *Counter, int *MaxNameSize) {
+  if (!IR || !Counter || !MaxNameSize) return -1;
+  const auto &F = *static_cast<const llvm::Function *>(IR);
+  const auto *Table = F.getValueSymbolTable();
+  if (!zilCurrentLocalNameMap(F, Table)) return -1;
+  *Counter = Table ? Table->zilProductLastUnique() : 0;
+  *MaxNameSize = Table ? Table->zilProductMaxNameSize() : 0;
+  return Table ? 1 : 0;
+}
+extern "C" LLVM_ABI int ZilLLVMRestoreFunctionSymbolState(
+    void *IR, int Present, uint32_t Counter, int MaxNameSize) {
+  if (!IR || (Present != 0 && Present != 1)) return 0;
+  auto &F = *static_cast<llvm::Function *>(IR);
+  auto *Table = F.getValueSymbolTable();
+  if (bool(Table) != bool(Present) || !zilCurrentLocalNameMap(F, Table)) return 0;
+  if (!Table) return Counter == 0 && MaxNameSize == 0;
+  return Table->zilRestoreProductLastUnique(Counter, MaxNameSize);
+}
