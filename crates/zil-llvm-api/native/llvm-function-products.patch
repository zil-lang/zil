+  // Restore a sealed resident product's original numbering, including holes.
+  // Current MBB owners/layout and current MMI FunctionNumber are retained.
+  bool zilRestoreProductBlockNumbers(unsigned Capacity, unsigned Next,
+      unsigned Epoch, ArrayRef<unsigned> Numbers,
+      ArrayRef<unsigned> AnalysisNumbers) {
+    if (Numbers.size() != size() || AnalysisNumbers.size() != size() ||
+        Capacity > (64 * 1024 * 1024) / sizeof(MachineBasicBlock *) ||
+        Next > (64 * 1024 * 1024) / sizeof(MachineBasicBlock *)) return false;
+    DenseSet<unsigned> IDs, AnalysisIDs;
+    for (unsigned I = 0; I != Numbers.size(); ++I)
+      if (Numbers[I] >= Capacity || Numbers[I] > unsigned(INT_MAX) ||
+          AnalysisNumbers[I] >= Next || AnalysisNumbers[I] > unsigned(INT_MAX) ||
+          !IDs.insert(Numbers[I]).second ||
+          !AnalysisIDs.insert(AnalysisNumbers[I]).second) return false;
+    std::vector<MachineBasicBlock *> NewTable(Capacity, nullptr);
+    unsigned I = 0;
+    for (MachineBasicBlock &BB : *this) NewTable[Numbers[I++]] = &BB;
+    I = 0;
+    for (MachineBasicBlock &BB : *this) {
+      BB.setNumber(Numbers[I]); BB.setAnalysisNumber(AnalysisNumbers[I]); ++I;
+    }
+    MBBNumbering.swap(NewTable);
+    NextAnalysisNumber = Next;
+    AnalysisNumberingEpoch = Epoch;
+    return true;
+  }
