+    if (!isa<GlobalValue>(I.getResolver())) orderValue(I.getResolver(), OM);
+    orderValue(&I, OM);
+  }
+  for (const Function &F : *M) {
+    for (const Use &U : F.operands())
+      if (!isa<GlobalValue>(U.get())) orderValue(U.get(), OM);
+    orderValue(&F, OM);
+  }
+  return OM;
+}
