+extern "C" LLVM_ABI uint64_t ZilLLVMTargetLibraryOverrideWords(
+    void *Manager, void *IR, uint64_t *Words, uint64_t Capacity) {
+  auto &F = *static_cast<llvm::Function *>(IR);
+  auto &AM = *static_cast<llvm::FunctionAnalysisManager *>(Manager);
+  auto *Info = AM.getCachedResult<llvm::TargetLibraryAnalysis>(F);
+  if (!Info) return 0;
+  constexpr uint64_t Count = (llvm::NumLibFuncs + 63) / 64;
+  if (!Words || Capacity < Count) return Count;
+  for (uint64_t I = 0; I != Count; ++I) Words[I] = 0;
+  const auto &Overrides = Info->zilProductOverrides();
+  for (unsigned I = 0; I != llvm::NumLibFuncs; ++I)
+    if (Overrides[I]) Words[I / 64] |= uint64_t(1) << (I % 64);
+  return Count;
+}
