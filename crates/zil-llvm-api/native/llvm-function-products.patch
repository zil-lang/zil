+extern "C" LLVM_ABI int ZilLLVMPrintModuleHeaders(const void *Input, void *Stream) {
+  if (!Input || !Stream) return 0;
+  const auto &M = *static_cast<const Module *>(Input);
+  if (!zilHeadersHaveNoBodyReferences(M)) return 0;
+  SlotTracker Slots(&M); formatted_raw_ostream OS(*static_cast<raw_ostream *>(Stream));
+  AssemblyWriter Writer(OS, Slots, &M, nullptr, false, true);
+  Writer.zilEnableHeaderMode(); Writer.printModule(&M); return 1;
+}
