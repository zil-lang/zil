+// Explicit scoped client only. The stock C API never installs a hook.
+static thread_local const ZilLLVMFunctionProductHooks *ZilFunctionHooks = nullptr;
+extern "C" LLVM_ABI const ZilLLVMFunctionProductHooks *
+ZilLLVMSetFunctionProductHooks(const ZilLLVMFunctionProductHooks *Hooks) {
+  const auto *Previous = ZilFunctionHooks;
+  ZilFunctionHooks = Hooks;
+  return Previous;
+}
+extern "C" LLVM_ABI const ZilLLVMFunctionProductHooks *
+ZilLLVMGetFunctionProductHooks() { return ZilFunctionHooks; }
