+// Resident X86 MFI copy: no LLVM-owner pointers may cross a request. The sole
+// PreallocatedIds writer is the IsPreallocated call-lowering path in fixed7a
+// X86ISelLoweringCall.cpp. This closed input predicate excludes that entire
+// path (and preallocated intrinsics), rather than trusting hasPreallocatedCall.
+static bool zilNoPreallocatedOwnerInputs(const llvm::Function &F) {
+  if (F.getCallingConv() != llvm::CallingConv::C || F.isVarArg())
+    return false;
+  for (const llvm::Argument &A : F.args())
+    if (!A.getType()->isIntegerTy())
+      return false;
+  for (const llvm::BasicBlock &BB : F)
+    for (const llvm::Instruction &I : BB) {
+      auto *CB = llvm::dyn_cast<llvm::CallBase>(&I);
+      if (!CB)
+        continue;
+      auto *Callee = CB->getCalledFunction();
+      if (!Callee || CB->getNumOperandBundles())
+        return false;
+      switch (Callee->getIntrinsicID()) {
+      case llvm::Intrinsic::sadd_with_overflow:
+      case llvm::Intrinsic::uadd_with_overflow:
+      case llvm::Intrinsic::ssub_with_overflow:
+      case llvm::Intrinsic::usub_with_overflow:
+      case llvm::Intrinsic::smul_with_overflow:
+      case llvm::Intrinsic::umul_with_overflow:
+      case llvm::Intrinsic::trap:
+        break;
+      default:
+        return false;
+      }
+      for (const llvm::Use &A : CB->args())
+        if (!A->getType()->isIntegerTy())
+          return false;
+    }
+  return true;
+}
+extern "C" LLVM_ABI void *ZilLLVMCloneX86ProductInfo(void *RawMF) {
+  auto &MF = *static_cast<llvm::MachineFunction *>(RawMF);
+  const auto &Triple = MF.getTarget().getTargetTriple();
+  if (Triple.getArch() != llvm::Triple::x86_64 || !Triple.isOSLinux() ||
+      !zilNoPreallocatedOwnerInputs(MF.getFunction()))
+    return nullptr;
+  const auto *Info = MF.getInfo<llvm::X86MachineFunctionInfo>();
+  if (Info->getStackPtrSaveMI() || Info->hasPreallocatedCall())
+    return nullptr;
+  return new llvm::X86MachineFunctionInfo(*Info);
+}
+extern "C" LLVM_ABI int ZilLLVMRestoreX86ProductInfo(void *RawMF,
+                                                  const void *Snapshot) {
+  if (!Snapshot)
+    return 0;
+  auto &MF = *static_cast<llvm::MachineFunction *>(RawMF);
+  const auto &Triple = MF.getTarget().getTargetTriple();
+  if (Triple.getArch() != llvm::Triple::x86_64 || !Triple.isOSLinux())
+    return 0;
+  *MF.getInfo<llvm::X86MachineFunctionInfo>() =
+      *static_cast<const llvm::X86MachineFunctionInfo *>(Snapshot);
+  return 1;
+}
+extern "C" LLVM_ABI void ZilLLVMDisposeX86ProductInfo(void *Snapshot) {
+  delete static_cast<llvm::X86MachineFunctionInfo *>(Snapshot);
+}
