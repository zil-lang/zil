+static OrderMap zilOrderHeaders(const Module *M) {
+  OrderMap OM;
+  for (const GlobalVariable &G : M->globals()) {
+    if (G.hasInitializer() && !isa<GlobalValue>(G.getInitializer()))
+      orderValue(G.getInitializer(), OM);
